{
  "name": "todo-monorepo",
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "bun --filter @todo/api dev",
    "dev:web": "bun --filter @todo/web dev",
    "test": "bun --filter @todo/api test",
    "typecheck": "bun --filter '*' typecheck",
    "build": "bun --filter @todo/web build"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}